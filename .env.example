# ==============================================================================
# OSINT-Based Attack Surface Intelligence & Risk Analysis Platform
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=osint_platform
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/osint_platform

# Security & Authentication (For future stages)
JWT_SECRET=development_jwt_secret_replace_in_production_environment_random_key_64chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External Intelligence APIs (For future stages)
GROQ_API_KEY=
